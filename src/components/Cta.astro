---
// The closing block on every page: a line in the serif and the contact form as the biggest link on the page.
import Button from './Button.astro';
import { site } from '../data/site';

interface Props {
	title?: string;
	body?: string;
}
const {
	title = 'Say hello.',
	body = 'Something you are building, a question about front-end work, a note about something you read here, or just hello. I like hearing from people, and I write back.',
} = Astro.props;
---

<section class="band">
	<div class="mx-auto grid max-w-5xl gap-8 px-6 py-16 lg:grid-cols-12 lg:py-24">
		<div class="lg:col-span-4">
			<p class="eyebrow">Contact</p>
			<h2 class="heading mt-3 text-4xl sm:text-5xl">{title}</h2>
		</div>
		<div class="lg:col-span-8">
			<a
				href="/contact/"
				class="heading inline-block text-[1.75rem] text-ink underline decoration-accent decoration-1 underline-offset-8 transition-colors hover:text-accent sm:text-4xl lg:text-5xl"
			>
				Write me a note →
			</a>
			<p class="mt-6 max-w-[52ch] leading-relaxed text-ink-2">{body}</p>
			<Button href={site.resume} variant="line" icon="arrow-right" class="mt-8">
				Read my resume
			</Button>
		</div>
	</div>
</section>
