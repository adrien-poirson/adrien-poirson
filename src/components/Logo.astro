---
// The mark: A and P drawn as one line, the way a chart line would, ending on a rust point, in a rounded tile.
// The tile is ink and the letters paper, so it flips with the theme: dark on light, light on dark.
// public/favicon.svg and scripts/og/*.html draw the same mark; change them together.
interface Props {
	name?: boolean;
	class?: string;
}
const { name = false, class: className } = Astro.props;
---

<span class:list={['inline-flex items-center gap-2.5', className]}>
	<svg class="size-8 shrink-0" viewBox="0 0 40 40" fill="none" aria-hidden="true">
		<rect
			x="0.75"
			y="0.75"
			width="38.5"
			height="38.5"
			rx="10"
			stroke-width="1.5"
			class="fill-ink stroke-ink"
		/>
		<g transform="translate(5.6 8.5) scale(.72)">
			<path
				d="M3 27 L10.5 5 L18 27 L23.5 27 V5 H29.5 a6.25 6.25 0 0 1 0 12.5 H23.5 M6.6 19.5 H14.4"
				stroke-width="3.8"
				stroke-linecap="round"
				stroke-linejoin="round"
				class="stroke-paper"
			/>
			<circle cx="37" cy="27" r="3" class="fill-accent" />
		</g>
	</svg>
	{name && <span class="text-[0.95rem] font-medium leading-none text-ink">Adrien Poirson</span>}
</span>
