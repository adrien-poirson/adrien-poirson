---
import Logo from './Logo.astro';
import Social from './Social.astro';
import { site } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="footer-fade border-t border-rule">
	<div class="mx-auto flex max-w-5xl items-center justify-between gap-4 px-6 py-7">
		<div class="flex items-center gap-4">
			<a href="/" aria-label="Adrien Poirson, home" class="shrink-0">
				<Logo />
			</a>
			<p class="mono text-ink-3">
				&copy; {year} {site.name}. Vancouver, Canada.
			</p>
		</div>
		<Social class="shrink-0" />
	</div>
</footer>
