---
import Logo from './Logo.astro';
import Social from './Social.astro';
import { nav, site } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="border-t border-rule">
	<div class="mx-auto flex max-w-5xl flex-col gap-4 px-6 py-7 sm:flex-row sm:items-center sm:justify-between">
		<div class="flex items-center gap-4">
			<a href="/" aria-label="Adrien Poirson, home">
				<Logo />
			</a>
			<p class="mono text-ink-3">
				&copy; {year} {site.name}. Vancouver, Canada.
			</p>
		</div>
		<div class="flex items-center gap-4">
			<ul class="eyebrow flex gap-5">
				{nav.map(({ href, label }) => (
					<li>
						<a href={href} class="hover:text-ink">
							{label}
						</a>
					</li>
				))}
			</ul>
			<Social />
		</div>
	</div>
</footer>
