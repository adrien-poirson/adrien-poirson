---
// GitHub and LinkedIn as small line icons.
import { site } from '../data/site';

interface Props {
	class?: string;
}
const { class: className } = Astro.props;
const links = [
	{
		href: site.github,
		label: 'GitHub',
		path: 'M9 19c-4.3 1.4-4.3-2.5-6-3m12 5v-3.5c0-1 .1-1.4-.5-2 2.8-.3 5.5-1.4 5.5-6a4.6 4.6 0 0 0-1.3-3.2 4.2 4.2 0 0 0-.1-3.2s-1.1-.3-3.5 1.3a12.3 12.3 0 0 0-6.2 0C6.5 2.8 5.4 3.1 5.4 3.1a4.2 4.2 0 0 0-.1 3.2A4.6 4.6 0 0 0 4 9.5c0 4.6 2.7 5.7 5.5 6-.6.6-.6 1.2-.5 2V21',
	},
	{
		href: site.linkedin,
		label: 'LinkedIn',
		path: 'M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6zM2 9h4v12H2zM4 3a2 2 0 1 1 0 4 2 2 0 0 1 0-4z',
	},
];
---

<ul class:list={['flex items-center gap-1', className]}>
	{links.map(({ href, label, path }) => (
		<li>
			<a
				href={href}
				target="_blank"
				rel="noopener noreferrer"
				aria-label={label}
				title={label}
				class="grid h-10 w-10 place-items-center rounded-full text-ink-2 transition-colors hover:bg-paper-2 hover:text-ink"
			>
				<svg viewBox="0 0 24 24" class="h-[18px] w-[18px]" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
					<path d={path} />
				</svg>
			</a>
		</li>
	))}
</ul>
