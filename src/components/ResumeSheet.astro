---
// The resume itself, from src/data/resume.ts. /resume/ shows it on the site, and /resume/print/ wraps it for `yarn resume`,
// which prints it to the PDF. The phone and email only appear in the print version, so they never reach the public HTML.
import { resume } from '../data/resume';

interface Props {
	/** Include the private contact lines (phone, email). Only the print page does. */
	withPrivate?: boolean;
	/** The name is the page's h1 on its own, and an h2 under the /resume/ page heading. */
	headingLevel?: 1 | 2;
}

const { withPrivate = false, headingLevel = 1 } = Astro.props;
const Name = headingLevel === 1 ? 'h1' : 'h2';
const contact = resume.contact.filter((c) => withPrivate || !c.private);
// Each skill line as separate items, splitting on commas outside parentheses.
const split = (items: string) => items.split(/,\s*(?![^()]*\))/);
---

<article class="sheet">
	<header class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
		<div>
			<Name class="heading text-[2.6rem] leading-none">{resume.name}</Name>
			<p class="mt-2 text-lg text-ink-2">{resume.title}</p>
		</div>
		<ul class="mono grid gap-0.5 text-ink-2 sm:text-right">
			{contact.map(({ label, href }) => (
				<li>
					{href ? (
						<a href={href} class="hover:text-accent">
							{label}
						</a>
					) : (
						label
					)}
				</li>
			))}
		</ul>
	</header>

	<p class="mt-5 max-w-[80ch] text-[0.98rem] leading-relaxed text-ink-2">{resume.summary}</p>

	<section class="mt-7">
		<h2 class="sheet-title heading">Skills</h2>
		<table class="mt-1 w-full border-collapse">
			<tbody>
				{resume.skills.map(({ title, items }) => (
					<tr class="block align-baseline py-3 print:table-row print:py-0">
						<th scope="row" class="block pr-4 text-left text-[0.8rem] font-medium text-ink-2 print:table-cell print:w-[11rem] print:py-2">
							{title}
						</th>
						<td class="mt-2 block text-[0.92rem] leading-snug print:mt-0 print:table-cell print:py-2">
							<ul class="skill-chips flex flex-wrap gap-1.5">
								{split(items).map((item) => (
									<li class="chip">{item}</li>
								))}
							</ul>
							<span class="skill-text">{items}</span>
						</td>
					</tr>
				))}
			</tbody>
		</table>
	</section>

	<section class="mt-7">
		<h2 class="sheet-title heading">Experience</h2>
		<ol>
			{resume.experience.map(({ company, url, location, role, period, bullets }) => (
				<li class="entry grid gap-x-6 gap-y-1 py-4 sm:grid-cols-[10.5rem_1fr]">
					<div>
						<p class="mono text-ink-3">{period}</p>
						<p class="mt-0.5 text-[0.85rem] text-ink-2">{location}</p>
					</div>
					<div>
						<h3 class="name text-[1.05rem] font-semibold leading-snug">
							{company}
							{url && <span class="mono ml-2 text-ink-3">{url}</span>}
						</h3>
						<p class="mt-0.5 text-[0.92rem] font-medium">{role}</p>
						<ul class="mt-2 grid gap-1.5">
							{bullets.map((b) => (
								<li class="grid grid-cols-[1rem_1fr] text-[0.92rem] leading-snug text-ink-2">
									<span class="mt-[0.6rem] block h-px w-2.5 bg-accent" aria-hidden="true" />
									<span>{b}</span>
								</li>
							))}
						</ul>
					</div>
				</li>
			))}
		</ol>
	</section>

	<section class="keep mt-7">
		<h2 class="sheet-title heading">Personal projects</h2>
		<ol>
			{resume.projects.map(({ name, url, period, body }) => (
				<li class="entry grid gap-x-6 gap-y-1 py-3.5 sm:grid-cols-[10.5rem_1fr]">
					<p class="mono text-ink-3">{period}</p>
					<div>
						<h3 class="name text-[1rem] font-semibold leading-snug">
							{name}
							{url && <span class="mono ml-2 text-ink-3">{url}</span>}
						</h3>
						<p class="mt-1 text-[0.92rem] leading-snug text-ink-2">{body}</p>
					</div>
				</li>
			))}
		</ol>
	</section>

	<section class="last mt-7 grid gap-6 sm:grid-cols-3">
		<div>
			<h2 class="sheet-title heading">Education</h2>
			{resume.education.map(({ degree, school, period }) => (
				<div class="mt-3">
					<p class="text-[0.92rem] font-medium leading-snug">{degree}</p>
					<p class="mt-0.5 text-[0.85rem] text-ink-2">{school}</p>
					<p class="mono mt-1 text-ink-3">{period}</p>
				</div>
			))}
		</div>
		<div>
			<h2 class="sheet-title heading">Languages</h2>
			<p class="mt-3 text-[0.92rem] text-ink-2">{resume.languages}</p>
		</div>
		<div>
			<h2 class="sheet-title heading">Interests</h2>
			<p class="mt-3 text-[0.92rem] text-ink-2">{resume.interests}</p>
		</div>
	</section>
</article>

<!-- Global so the print rules reach html and body. Only pages showing the resume load it. -->
<style is:global>
	/* Section titles: large display type on screen, smaller in the PDF so it stays short. No rules: space separates the sections. */
	.sheet > section {
		margin-top: 3.5rem;
	}
	/* Skills are pills on screen and a plain line in the PDF, which keeps it short. */
	.skill-text {
		display: none;
	}
	.sheet-title {
		font-size: 1.75rem;
		color: var(--ink);
		padding-bottom: 0.4rem;
	}
	@page {
		size: Letter;
		margin: 0.5in 0.55in;
	}
	@media print {
		html {
			font-size: 13.5px;
		}
		body {
			background: #fff;
		}
		/* Printing /resume/ from the browser gives the sheet alone, without the site around it. */
		body > header,
		body > footer,
		.no-print {
			display: none !important;
		}
		.entry li,
		.entry p,
		.last {
			break-inside: avoid;
		}
		.sheet > section {
			margin-top: 2rem;
		}
		.sheet-title {
			font-size: 1.2rem;
			padding-bottom: 0.15rem;
		}
		/* Short sections print in one piece, so their title never ends a page alone. */
		.keep {
			break-inside: avoid;
		}
		.skill-chips {
			display: none;
		}
		.skill-text {
			display: inline;
		}
		h2,
		h3,
		.name + p {
			break-after: avoid;
		}
		a {
			color: inherit;
			text-decoration: none;
		}
	}
</style>
