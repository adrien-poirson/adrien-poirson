---
// The resume as a page, laid out for Letter paper. `yarn resume` prints it to public/ResumeAdrienPoirson.pdf.
import '../styles/global.css';
import { resume } from '../data/resume';
import { site } from '../data/site';

const description = 'Resume of Adrien Poirson, software engineer in Vancouver.';
---

<!doctype html>
<html lang="en" data-theme="light">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="robots" content="noindex" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="canonical" href={new URL('/resume/', Astro.site)} />
		<title>Resume | {site.name}</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600&family=Instrument+Serif:ital@0;1&family=JetBrains+Mono:wght@400;500&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body class="bg-paper font-sans text-ink">
		<main class="sheet mx-auto max-w-[8.5in] px-8 py-10 sm:px-12 sm:py-12">
			<header class="flex flex-col gap-4 border-b border-ink pb-5 sm:flex-row sm:items-end sm:justify-between">
				<div>
					<h1 class="heading text-[2.6rem] leading-none">{resume.name}</h1>
					<p class="mt-2 text-lg text-ink-2">{resume.title}</p>
				</div>
				<ul class="mono grid gap-0.5 text-ink-2 sm:text-right">
					{resume.contact.map(({ label, href }) => (
						<li>
							{href ? (
								<a href={href} class="hover:text-accent">
									{label}
								</a>
							) : (
								label
							)}
						</li>
					))}
				</ul>
			</header>

			<p class="mt-5 max-w-[80ch] text-[0.98rem] leading-relaxed text-ink-2">{resume.summary}</p>

			<section class="mt-7">
				<h2 class="eyebrow border-b border-rule pb-2">Skills</h2>
				<table class="mt-1 w-full border-collapse">
					<tbody class="divide-y divide-rule">
						{resume.skills.map(({ title, items }) => (
							<tr class="align-baseline">
								<th scope="row" class="w-[11rem] py-1.5 pr-4 text-left text-[0.8rem] font-medium text-ink-3">
									{title}
								</th>
								<td class="py-1.5 text-[0.92rem] leading-snug">{items}</td>
							</tr>
						))}
					</tbody>
				</table>
			</section>

			<section class="mt-7">
				<h2 class="eyebrow border-b border-rule pb-2">Experience</h2>
				<ol>
					{resume.experience.map(({ company, url, location, role, period, bullets }) => (
						<li class="entry grid gap-x-6 gap-y-1 border-b border-rule py-3.5 last:border-0 sm:grid-cols-[10.5rem_1fr]">
							<div>
								<p class="mono text-ink-3">{period}</p>
								<p class="mt-0.5 text-[0.85rem] text-ink-2">{location}</p>
							</div>
							<div>
								<h3 class="name text-[1.05rem] font-semibold leading-snug">
									{company}
									{url && <span class="mono ml-2 text-ink-3">{url}</span>}
								</h3>
								<p class="mt-0.5 text-[0.92rem] font-medium">{role}</p>
								<ul class="mt-2 grid gap-1.5">
									{bullets.map((b) => (
										<li class="grid grid-cols-[1rem_1fr] text-[0.92rem] leading-snug text-ink-2">
											<span class="mt-[0.6rem] block h-px w-2.5 bg-accent" aria-hidden="true" />
											<span>{b}</span>
										</li>
									))}
								</ul>
							</div>
						</li>
					))}
				</ol>
			</section>

			<section class="mt-7">
				<h2 class="eyebrow border-b border-rule pb-2">Personal projects</h2>
				<ol>
					{resume.projects.map(({ name, url, period, body }) => (
						<li class="entry grid gap-x-6 gap-y-1 border-b border-rule py-3 last:border-0 sm:grid-cols-[10.5rem_1fr]">
							<p class="mono text-ink-3">{period}</p>
							<div>
								<h3 class="name text-[1rem] font-semibold leading-snug">
									{name}
									{url && <span class="mono ml-2 text-ink-3">{url}</span>}
								</h3>
								<p class="mt-1 text-[0.92rem] leading-snug text-ink-2">{body}</p>
							</div>
						</li>
					))}
				</ol>
			</section>

			<section class="last mt-7 grid gap-6 sm:grid-cols-3">
				<div>
					<h2 class="eyebrow border-b border-rule pb-2">Education</h2>
					{resume.education.map(({ degree, school, period }) => (
						<div class="mt-3">
							<p class="text-[0.92rem] font-medium leading-snug">{degree}</p>
							<p class="mt-0.5 text-[0.85rem] text-ink-2">{school}</p>
							<p class="mono mt-1 text-ink-3">{period}</p>
						</div>
					))}
				</div>
				<div>
					<h2 class="eyebrow border-b border-rule pb-2">Languages</h2>
					<p class="mt-3 text-[0.92rem] text-ink-2">{resume.languages}</p>
				</div>
				<div>
					<h2 class="eyebrow border-b border-rule pb-2">Interests</h2>
					<p class="mt-3 text-[0.92rem] text-ink-2">{resume.interests}</p>
				</div>
			</section>
		</main>

		<style>
			@page {
				size: Letter;
				margin: 0.5in 0.55in;
			}
			@media print {
				html {
					font-size: 13.5px;
				}
				body {
					background: #fff;
				}
				.sheet {
					max-width: none;
					padding: 0;
				}
				.entry li,
				.entry p,
				.last {
					break-inside: avoid;
				}
				h2,
				h3,
				.name + p {
					break-after: avoid;
				}
				a {
					color: inherit;
					text-decoration: none;
				}
			}
		</style>
	</body>
</html>
