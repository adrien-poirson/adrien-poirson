---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Cta from '../components/Cta.astro';
import { roles, projects } from '../data/experience';
import { experience } from '../data/site';
import { pipeline } from '../data/pipeline';

const description =
	'Adrien Poirson’s work, in order: PolicyReporter, CS Disco, Global Relay, Calabrio, Cumul8, Thinkingbox and JCOMMOPS, plus personal projects.';
const slug = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, '-');
const host = (url: string) => url.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '');
---

<Layout title="Work" description={description} pageType="CollectionPage">
	<section class="dotgrid">
		<div class="mx-auto max-w-5xl px-6 pb-14 pt-16 sm:pt-24 lg:pb-20 lg:pt-32">
			<p class="eyebrow">Work — {roles.length} roles, newest first</p>
			<h1 class="display mt-6 max-w-[14ch] text-[3rem] sm:text-[4.25rem] lg:text-[5rem]">
				{experience.words[0].toUpperCase() + experience.words.slice(1)} years on the front end of <em>data.</em>
			</h1>
			<p class="mt-10 max-w-[52ch] text-xl leading-relaxed text-ink-2">
				I started on ocean-research data in France and moved to Vancouver in 2015. Since then nearly every role has been the same problem in a new domain: a lot
				of data, and people who need to understand it quickly.
			</p>
		</div>
	</section>

	<!-- The timeline: a rail down the left, the company and dates sticky beside the story on wide screens. -->
	<section class="mx-auto max-w-5xl px-6 pb-16 lg:pb-24">
		<ol class="rail ml-1 sm:ml-2" data-timeline>
			{roles.map(({ company, url, location, role, period, lead, stack, story, highlights, link, image, imageAlt, imagePosition }) => (
				<li id={slug(company)} class="grid scroll-mt-28 gap-6 py-10 pl-7 sm:pl-10 lg:grid-cols-12 lg:gap-10 lg:py-14">
					<div class="lg:sticky lg:top-24 lg:col-span-4 lg:self-start">
						<h2 class="heading text-3xl sm:text-4xl">{company}</h2>
						<p class="mono mt-2 text-ink-3">{period}</p>
						<p class="mt-3 font-medium">{role}</p>
						<p class="mt-1 text-[0.95rem] text-ink-2">{location}</p>
						{url && (
							<a href={url} target="_blank" rel="noopener" class="link mono mt-4 inline-block">
								{host(url)} ↗
							</a>
						)}
						<ul class="mt-5 flex flex-wrap gap-1.5">
							{stack.map((s) => (
								<li class="chip">{s}</li>
							))}
						</ul>
					</div>
					<div class="lg:col-span-8 lg:pt-14">
						<p class="heading max-w-[40ch] text-2xl text-ink">{lead}</p>
						<div class="mt-4 max-w-[62ch] space-y-5 text-lg leading-relaxed text-ink-2">
							{story.map((p) => (
								<p>{p}</p>
							))}
						</div>
						{highlights && (
							<ul class="mt-8">
								{highlights.map((item) => (
									<li class="grid gap-3 py-2.5 sm:grid-cols-[2rem_1fr]">
										<span class="mt-[0.7rem] block h-px w-4 bg-accent" aria-hidden="true" />
										<span class="leading-relaxed">{item}</span>
									</li>
								))}
							</ul>
						)}
						{link && (
							<a href={link.href} target="_blank" rel="noopener" class="link mt-6 inline-block font-medium">
								{link.label} ↗
							</a>
						)}
						{image && (
							<figure class="mt-8">
								<div class="shot">
									<Image
										src={image}
										alt={imageAlt ?? company}
										widths={[480, 800, 1200, 1600]}
										sizes="(min-width: 1024px) 680px, calc(100vw - 3rem)"
										class="h-auto w-full"
										style={imagePosition && `object-position: ${imagePosition}`}
									/>
								</div>
								{imageAlt && <figcaption class="mono mt-3 text-ink-3">{imageAlt}</figcaption>}
							</figure>
						)}
					</div>
				</li>
			))}
		</ol>
	</section>

	<!-- The pipeline I own: six numbered steps down the page, each with what it means and the tools behind it. -->
	<section class="band" id="pipeline">
		<div class="mx-auto max-w-5xl px-6 py-16 lg:py-24">
			<div class="grid gap-6 lg:grid-cols-12">
				<div class="lg:col-span-6">
					<p class="eyebrow">{pipeline.eyebrow}</p>
					<h2 class="heading mt-3 text-4xl sm:text-5xl">
						{pipeline.heading[0]}
						<em>{pipeline.heading[1]}</em>
					</h2>
				</div>
				<p class="max-w-[46ch] self-end text-lg leading-relaxed text-ink-2 lg:col-span-5 lg:col-start-8">{pipeline.lead}</p>
			</div>
			<ol class="mt-12 lg:mt-14">
				{pipeline.steps.map(({ title, body, tools }, i) => (
					<li class="grid gap-x-10 gap-y-3 py-5 sm:grid-cols-[3rem_1fr] lg:grid-cols-[3rem_11rem_1fr_15rem] lg:items-baseline">
						<p class="mono text-accent">{String(i + 1).padStart(2, '0')}</p>
						<h3 class="heading text-2xl">{title}</h3>
						<p class="leading-relaxed text-ink-2 sm:col-start-2 lg:col-start-auto">{body}</p>
						<ul class="flex flex-wrap gap-1.5 sm:col-start-2 lg:col-start-auto">
							{tools.map((t) => (
								<li class="chip">{t}</li>
							))}
						</ul>
					</li>
				))}
			</ol>
		</div>
	</section>

	<!-- Personal projects: the heading on top, then one row per project, its name and stack beside the story. -->
	<section class="bg-paper-2">
		<div class="mx-auto max-w-5xl px-6 py-16 lg:py-24">
			<p class="eyebrow">On my own time</p>
			<h2 class="heading mt-3 text-4xl sm:text-5xl">
				Projects that started as an <em>itch.</em>
			</h2>
			<ol class="mt-6 lg:mt-10">
				{projects.map(({ name, url, period, lead, story, stack, image, imageAlt, imagePosition }) => (
					<li id={slug(name)} class="grid scroll-mt-28 gap-4 py-8 lg:grid-cols-12 lg:gap-10 lg:py-10">
						<div class="lg:col-span-4">
							<h3 class="heading text-3xl">
								{url ? (
									<a href={url} target="_blank" rel="noopener" class="transition-colors hover:text-accent">
										{name} ↗
									</a>
								) : (
									name
								)}
							</h3>
							<p class="mono mt-2 text-ink-3">{period}</p>
							<ul class="mt-4 flex flex-wrap gap-1.5">
								{stack.map((s) => (
									<li class="chip">{s}</li>
								))}
							</ul>
						</div>
						<div class="lg:col-span-8 lg:pt-14">
							<p class="heading max-w-[40ch] text-2xl text-ink">{lead}</p>
							<div class="mt-4 max-w-[62ch] space-y-3 text-lg leading-relaxed text-ink-2">
								{story.map((p) => (
									<p>{p}</p>
								))}
							</div>
							{image && (
								<figure class="mt-6">
									<div class="shot">
										<Image
											src={image}
											alt={imageAlt ?? name}
											widths={[480, 800, 1200, 1600]}
											sizes="(min-width: 1024px) 680px, calc(100vw - 3rem)"
											class="h-auto w-full"
											style={imagePosition && `object-position: ${imagePosition}`}
										/>
									</div>
									{imageAlt && <figcaption class="mono mt-3 text-ink-3">{imageAlt}</figcaption>}
								</figure>
							)}
						</div>
					</li>
				))}
			</ol>
		</div>
	</section>

	<Cta
		title="Curious about any of this?"
		body="Happy to go into the details of any of it, or to compare notes if you have solved the same problems differently."
	/>
</Layout>

<script>
	// Animates the timeline as you scroll; the styles are .rail-animated in global.css.
	const rail = document.querySelector<HTMLElement>('[data-timeline]');
	if (rail && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
		const entries = [...rail.children] as HTMLElement[];
		rail.classList.add('rail-animated');

		const appear = new IntersectionObserver(
			(seen) => {
				for (const { isIntersecting, target } of seen) {
					if (!isIntersecting) continue;
					target.classList.add('is-visible');
					appear.unobserve(target);
				}
			},
			{ rootMargin: '0px 0px -12% 0px' },
		);
		entries.forEach((li) => appear.observe(li));

		// The reading line sits a little above the middle of the screen.
		const dotOffset = parseFloat(getComputedStyle(document.documentElement).fontSize) * 3.4;
		let queued = false;
		const update = () => {
			queued = false;
			const line = innerHeight * 0.45;
			const box = rail.getBoundingClientRect();
			const progress = Math.min(1, Math.max(0, (line - box.top) / box.height));
			rail.style.setProperty('--rail-progress', progress.toFixed(4));
			for (const li of entries) li.classList.toggle('is-reached', li.getBoundingClientRect().top + dotOffset <= line);
		};
		const queue = () => {
			if (queued) return;
			queued = true;
			requestAnimationFrame(update);
		};
		addEventListener('scroll', queue, { passive: true });
		addEventListener('resize', queue);
		update();
	}
</script>
