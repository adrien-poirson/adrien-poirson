---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import Principles from '../components/Principles.astro';
import AiPractice from '../components/AiPractice.astro';
import Cta from '../components/Cta.astro';
import { roles } from '../data/experience';
import { offers } from '../data/skills';
import { experience, site } from '../data/site';

const stats = [
	{ value: `${experience.years}+`, label: 'years on the front end of data products' },
	{ value: '7', label: 'companies, from a research lab to a public US software company' },
	{ value: '2018', label: 'the year I went remote, and stayed' },
	{ value: '2', label: 'languages: English and French' },
];
const now = [
	{ label: 'Currently', value: `${site.currentRole} at ${site.employer}` },
	{ label: 'Previously', value: 'CS Disco, Calabrio, Cumul8' },
	{ label: 'Based in', value: 'Vancouver, Canada' },
];
const featured = roles.filter((r) => r.featured);
const slug = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, '-');
---

<Layout title="Home">
	<!-- Hero: type on graph paper. -->
	<section class="dotgrid">
		<div class="mx-auto max-w-5xl px-6 pb-16 pt-16 sm:pt-24 lg:pb-24 lg:pt-32">
			<p class="eyebrow">Adrien Poirson — {site.role}, Vancouver</p>
			<h1 class="display mt-6 max-w-[15ch] text-[3rem] sm:text-[4.25rem] lg:text-[5.5rem]">
				I build software that turns complicated data into something <em>clear.</em>
			</h1>
			<div class="mt-12 grid gap-10 lg:grid-cols-12">
				<p class="max-w-[52ch] text-xl leading-relaxed text-ink-2 lg:col-span-7">
					For over {experience.words} years I have worked on the front end of data products: analytics dashboards, reporting tools and data explorers for legal, contact-centre
					and research platforms. Mostly React and TypeScript, with the back end and the database when the project needs them.
				</p>
				<dl class="grid gap-4 self-end lg:col-span-4 lg:col-start-9">
					{now.map(({ label, value }) => (
						<div class="grid grid-cols-[6.5rem_1fr] items-baseline gap-3 border-t border-rule pt-3">
							<dt class="eyebrow">{label}</dt>
							<dd class="font-medium">{value}</dd>
						</div>
					))}
				</dl>
			</div>
			<div class="mt-10 flex flex-wrap items-center gap-3">
				<Button href="/work/" icon="arrow-right">
					See the work
				</Button>
				<Button href="/contact/" variant="line">
					Get in touch
				</Button>
			</div>
		</div>
	</section>

	<!-- Four numbers, as dashboard tiles. -->
	<section class="mx-auto max-w-5xl px-6">
		<dl class="grid grid-cols-2 gap-3 sm:gap-4 lg:grid-cols-4">
			{stats.map(({ value, label }) => (
				<div class="flex flex-col tile rounded-xl border border-rule p-4 sm:p-5">
					<dd class="font-display text-4xl leading-none tracking-tight tabular-nums sm:text-5xl" data-count={value}>{value}</dd>
					<dt class="mt-3 text-[0.9rem] leading-snug text-ink-2">{label}</dt>
				</div>
			))}
		</dl>
	</section>

	<!-- What I do: a numbered list. -->
	<section class="mx-auto max-w-5xl px-6 py-16 lg:py-24">
		<div class="grid gap-10 lg:grid-cols-12">
			<div class="lg:col-span-4">
				<p class="eyebrow">01 — What I do</p>
				<h2 class="heading mt-3 text-4xl sm:text-5xl">
					Where data meets <em>people.</em>
				</h2>
				<p class="mt-5 max-w-[34ch] leading-relaxed text-ink-2">The four things I get asked to build most, and the ones I am best at.</p>
			</div>
			<ol class="lg:col-span-8">
				{offers.map(({ title, body, icon, accent }, i) => (
					<li class="group grid gap-3 py-7 sm:grid-cols-[3.5rem_1fr]">
						<!-- The number with its icon: side by side on phones, the icon under the number on wider screens. -->
						<div class="flex items-start justify-between sm:flex-col sm:justify-start sm:gap-5">
							<p class="mono pt-1 text-ink-3">{String(i + 1).padStart(2, '0')}</p>
							<svg
								class="size-12 opacity-[0.14] transition-opacity duration-500 group-hover:opacity-30 sm:size-10 dark:opacity-[0.18] dark:group-hover:opacity-35"
								viewBox="0 0 24 24"
								fill="none"
								stroke-width="1.3"
								stroke-linecap="round"
								stroke-linejoin="round"
								aria-hidden="true"
							>
								<path d={icon} class="stroke-ink" />
								<path d={accent} class="stroke-accent" stroke-width="1.6" />
							</svg>
						</div>
						<div>
							<h3 class="heading text-2xl">{title}</h3>
							<p class="mt-3 max-w-[58ch] leading-relaxed text-ink-2">{body}</p>
						</div>
					</li>
				))}
			</ol>
		</div>
	</section>

	<!-- Selected work: a teaser per role, the hard problem in one line, with the full story on the work page. -->
	<section class="band">
		<div class="mx-auto max-w-5xl px-6 py-16 lg:py-24">
			<div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
				<div>
					<p class="eyebrow">02 — Selected work</p>
					<h2 class="heading mt-3 max-w-[16ch] text-4xl sm:text-5xl">
						Three places where the data was the <em>hard part.</em>
					</h2>
				</div>
				<a href="/work/" class="link shrink-0 font-medium">
					The whole story, in order
				</a>
			</div>
			<ol class="mt-12">
				{featured.map(({ company, period, role, summary }) => (
					<li class="grid gap-3 py-8 lg:grid-cols-12 lg:gap-10">
						<div class="lg:col-span-4">
							<h3 class="heading text-3xl">{company}</h3>
							<p class="mono mt-2 text-ink-3">{period}</p>
							<p class="mt-3 font-medium">{role}</p>
						</div>
						<div class="lg:col-span-8 lg:pt-1">
							<p class="heading max-w-[34ch] text-2xl text-ink">{summary}</p>
							<a href={`/work/#${slug(company)}`} class="link mt-4 inline-block font-medium">
								Read the story →
							</a>
						</div>
					</li>
				))}
			</ol>
		</div>
	</section>

	<AiPractice />

	<Principles index="04" />

	<Cta />
</Layout>

<script>
	// The stats count up to their values once, the first time they come into view.
	// The real value is already in the HTML, so without JS, or with reduced motion, they simply show.
	const stats = [...document.querySelectorAll<HTMLElement>('[data-count]')];
	if (stats.length && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
		const duration = 1400;
		const ease = (t: number) => 1 - Math.pow(1 - t, 3);
		const run = (el: HTMLElement) => {
			const [, digits, suffix] = el.dataset.count!.match(/^(\d+)(.*)$/) ?? [];
			if (!digits) return;
			const to = Number(digits);
			// A year counts up from the start of its century, not from zero.
			const from = to >= 1000 ? Math.floor(to / 100) * 100 : 0;
			el.textContent = from + suffix;
			const start = performance.now();
			const tick = (now: number) => {
				const t = Math.min(1, (now - start) / duration);
				el.textContent = Math.round(from + (to - from) * ease(t)) + suffix;
				if (t < 1) requestAnimationFrame(tick);
			};
			requestAnimationFrame(tick);
		};
		const seen = new IntersectionObserver(
			(entries) => {
				if (!entries.some((e) => e.isIntersecting)) return;
				seen.disconnect();
				stats.forEach(run);
			},
			{ rootMargin: '0px 0px -10% 0px' },
		);
		seen.observe(stats[0].closest('dl') ?? stats[0]);
	}
</script>
